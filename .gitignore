# ---------- Python virtual environment (yours lives in the project root) ----------
/Lib/
/Scripts/
/Include/
/share/
/pyvenv.cfg
.venv/
venv/
env/

# ---------- Python build and cache ----------
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ipynb_checkpoints/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---------- Data (rebuilt by prepare_data.py) ----------
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
*.jsonl.gz
*.parquet

# ---------- Model artifacts (rebuilt by build_artifacts.py) ----------
artifacts/*.pkl
artifacts/*.pt
artifacts/*.faiss
# small result tables (results_*.csv, leaderboard.csv) ARE tracked, so the README can quote them

# ---------- Secrets and editor/OS files ----------
.env
.streamlit/secrets.toml
.vscode/
.idea/
.DS_Store
Thumbs.db

!data/processed/
!data/processed/*
!artifacts/bundle.pkl
